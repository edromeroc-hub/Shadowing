# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# This branch targets a rights-cleared first-party catalog.
COMMERCIAL_CATALOG_MODE="true"
CATALOG_API_URL="MY_CATALOG_API_URL"
MEDIA_CDN_URL="MY_MEDIA_CDN_URL"

# Firebase client identifiers. Restrict the API key in Google Cloud and enforce
# Firebase Auth, Firestore and Storage security rules for every user resource.
VITE_FIREBASE_API_KEY="MY_FIREBASE_WEB_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="MY_PROJECT.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="MY_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="MY_PROJECT.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="MY_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="MY_FIREBASE_APP_ID"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional: override the Gemini model used for translation/segmentation.
GEMINI_MODEL="gemini-2.5-flash"

# Optional: true sends the full transcript to Gemini to choose shadowing clips.
GEMINI_SEGMENTATION_ENABLED="true"
