# Public Firebase Web SDK values embedded in the web/iOS app. They identify the
# project but are not server secrets; authorization remains enforced server-side.
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_WEB_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="shadowing-commercial-edromero.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="shadowing-commercial-edromero"
VITE_FIREBASE_STORAGE_BUCKET="shadowing-commercial-edromero.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="656360211453"
VITE_FIREBASE_APP_ID="1:656360211453:web:a3073ad7ed7518c353cf94"
VITE_COMMERCIAL_CATALOG_MODE="true"
VITE_API_URL=""

# Firebase Admin uses Application Default Credentials automatically in Google
# Cloud. Locally, point GOOGLE_APPLICATION_CREDENTIALS to a private JSON file
# outside the repository. Never prefix this path or its contents with VITE_.
FIREBASE_PROJECT_ID="shadowing-commercial-edromero"
FIREBASE_STORAGE_BUCKET="shadowing-commercial-edromero.firebasestorage.app"
GOOGLE_APPLICATION_CREDENTIALS="/absolute/private/path/firebase-admin.json"

# Commercial production mode requires login for AI, disables local API-key
# settings and blocks every legacy YouTube extraction/download route.
COMMERCIAL_CLOUD_MODE="true"
ENABLE_LEGACY_YOUTUBE="false"
APP_ALLOWED_ORIGINS="https://app.example.com,capacitor://localhost"

# One server-side Gemini key shared safely behind authentication and usage limits.
GEMINI_API_KEY="YOUR_SERVER_GEMINI_KEY"

# Optional: override the Gemini model used for translation/segmentation.
GEMINI_MODEL="gemini-2.5-flash"

# Optional: true sends the full transcript to Gemini to choose shadowing clips.
GEMINI_SEGMENTATION_ENABLED="true"
